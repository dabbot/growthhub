# Copy to .env and fill in. Never commit .env.

# Supabase project (Project settings → API)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."          # server only
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Who may sign in (comma-separated). With nothing set, nobody can sign in.
VITE_ALLOWED_EMAIL_DOMAINS="yourcompany.com"
VITE_ALLOWED_EMAILS=""

# Optional: email this address on every sign-in (sent with Resend)
SIGN_IN_ALERT_EMAIL=""
RESEND_API_KEY=""
EMAIL_FROM="Growth Dashboard <alerts@yourdomain.com>"

# AI features (Ask the Map, Growth Agents, campaign writer, ad creatives).
# Any OpenAI-compatible API. Leave AI_BASE_URL empty for OpenAI.
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL="gpt-5"
AI_IMAGE_MODEL="gpt-image-1"

# Optional: Google Ads campaign creation
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
